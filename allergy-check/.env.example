# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않음)

# console.anthropic.com → API Keys 에서 만든 키. 서버에서만 쓰고 브라우저로 보내지 않음.
ANTHROPIC_API_KEY=

# 배포할 때 꼭 정하세요. 주소를 아는 다른 사람이 내 API 크레딧을 쓰지 못하게 막는 가족 비밀번호.
# 비워 두면 확인하지 않음(집 컴퓨터에서 시험할 때만).
FAMILY_ACCESS_CODE=

# (선택) 사진 분석 모델. 기본 claude-opus-5-5. 예: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=
